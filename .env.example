# Copy to .env (never commit .env).

# --- Chain ---
# "memory" runs fully offline; "web3" talks to a real chain using contracts/deployments/<CHAIN_NETWORK>.json
CHAIN_BACKEND=memory
CHAIN_NETWORK=amoy                 # amoy | sepolia | localhost
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=              # test wallet only; owner + demo operator
VERIFIER_PRIVATE_KEY=              # second test wallet for the demo verifier
POLYGONSCAN_API_KEY=               # optional, for contract verification on the explorer
ETHERSCAN_API_KEY=
EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/

# --- Backend ---
DATABASE_URL=sqlite:///./verdant.db
SIGNATURE_SCHEMES=ML-DSA-65,ECDSA-P256-SHA256   # emergency fallback: ECDSA-P256-SHA256 only (clearly labelled)
OQS_INSTALL_PATH=                  # set if liboqs is not in /opt/homebrew/opt/liboqs
